# ------------------------------------------------------------------------------
# 42 Intranet API Credentials (OAuth2)
# Register your application at: https://profile.intra.42.fr/oauth/applications
# Note: Variables prefixed with EXPO_PUBLIC_ are accessible in client-side code.
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FT_CLIENT_ID=your_42_api_uid_here
EXPO_PUBLIC_FT_CLIENT_SECRET=your_42_api_secret_here

# ------------------------------------------------------------------------------
# API Endpoints Configuration
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FT_API_URL=https://api.intra.42.fr
EXPO_PUBLIC_FT_OAUTH_TOKEN_URL=https://api.intra.42.fr/oauth/token
